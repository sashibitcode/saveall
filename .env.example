# Frontend build-time variable (Vercel / local .env):
# Supports both VITE_API_URL and VITE_API_BASE_URL.
# If omitted in production, defaults to https://saveall-api.onrender.com
VITE_API_URL=https://saveall-api.onrender.com
VITE_API_BASE_URL=https://saveall-api.onrender.com

# Backend runtime variables (Render):
# FRONTEND_ORIGIN / FRONTEND_ORIGINS: Comma-separated allowed frontend origins for CORS.
# Defaults allow all *.vercel.app and localhost origins.
FRONTEND_ORIGIN=https://saveall.vercel.app
FRONTEND_ORIGINS=https://saveall.vercel.app,https://saveall-sashibitcode.vercel.app

# PUBLIC_API_URL: Canonical public HTTPS URL of the backend (e.g. for generating download links)
PUBLIC_API_URL=https://saveall-api.onrender.com

# Optional base64-encoded Netscape cookies.txt for authenticated / restricted media
# INSTAGRAM_COOKIES_B64=
# YOUTUBE_COOKIES_B64=
