# Vercel build-time variable: the public Render API URL
VITE_API_BASE_URL=https://saveall-api.onrender.com

# Render backend variables
FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
FRONTEND_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.example
PUBLIC_API_URL=https://saveall-api.onrender.com

# Optional Render secret: base64-encoded Netscape cookies.txt for YouTube access
YOUTUBE_COOKIES_B64=

# Optional Render secret for private/login-required Instagram content
INSTAGRAM_COOKIES_B64=
